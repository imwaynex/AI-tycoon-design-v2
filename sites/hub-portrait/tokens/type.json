{
  "id": "type",
  "family": {
    "text": "system-ui, sans-serif",
    "mono": "ui-monospace, monospace"
  },
  "weight": {
    "regular": 400,
    "strong": 600
  },
  "role": {
    "display": {
      "size": "clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem)",
      "lineHeight": 1.15,
      "weight": "{type.weight.strong}",
      "family": "{type.family.text}"
    },
    "title": {
      "size": "clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem)",
      "lineHeight": 1.25,
      "weight": "{type.weight.strong}",
      "family": "{type.family.text}"
    },
    "heading": {
      "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.375rem)",
      "lineHeight": 1.3,
      "weight": "{type.weight.strong}",
      "family": "{type.family.text}"
    },
    "body": {
      "size": "1rem",
      "lineHeight": 1.5,
      "weight": "{type.weight.regular}",
      "family": "{type.family.text}"
    },
    "label": {
      "size": "0.875rem",
      "lineHeight": 1.4,
      "weight": "{type.weight.strong}",
      "family": "{type.family.text}"
    },
    "caption": {
      "size": "0.75rem",
      "lineHeight": 1.4,
      "weight": "{type.weight.regular}",
      "family": "{type.family.text}"
    }
  },
  "floorPx": {
    "body": 16,
    "caption": 12
  }
}

    { "fg": "{color.semantic.text.secondary}", "bg": "{color.semantic.bg.sunken}", "min": 4.5 },
    { "fg": "{color.semantic.text.tertiary}", "bg": "{color.semantic.bg.canvas}", "min": 4.5 },
    { "fg": "{color.semantic.text.tertiary}", "bg": "{color.semantic.bg.surface}", "min": 4.5 },
    { "fg": "{color.semantic.text.tertiary}", "bg": "{color.semantic.bg.sunken}", "min": 4.5 },
    { "fg": "{color.semantic.text.link}", "bg": "{color.semantic.bg.canvas}", "min": 4.5 },
    { "fg": "{color.semantic.text.link}", "bg": "{color.semantic.bg.surface}", "min": 4.5 },
    { "fg": "{color.semantic.text.link}", "bg": "{color.semantic.bg.sunken}", "min": 4.5 },

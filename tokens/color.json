      "warning": "{color.primitive.orange.800}",
      "danger": "{color.primitive.red.800}",
      "info": "{color.primitive.blue.600}"
    }
  },
  "contrast": [
    { "fg": "{color.semantic.text.primary}", "bg": "{color.semantic.bg.canvas}", "min": 7 },
    { "fg": "{color.semantic.text.primary}", "bg": "{color.semantic.bg.surface}", "min": 7 },
    { "fg": "{color.semantic.text.primary}", "bg": "{color.semantic.bg.sunken}", "min": 7 },

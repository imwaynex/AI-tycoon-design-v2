    { "fg": "{color.semantic.text.inverse}", "bg": "{color.semantic.bg.inverse}", "min": 7 },
    { "fg": "{color.semantic.feedback.success}", "bg": "{color.semantic.bg.canvas}", "min": 4.5 },
    { "fg": "{color.semantic.feedback.success}", "bg": "{color.semantic.bg.surface}", "min": 4.5 },

    { "fg": "{color.semantic.feedback.warning}", "bg": "{color.semantic.bg.canvas}", "min": 4.5 },
    { "fg": "{color.semantic.feedback.warning}", "bg": "{color.semantic.bg.surface}", "min": 4.5 },
    { "fg": "{color.semantic.feedback.warning}", "bg": "{color.semantic.bg.sunken}", "min": 4.5 },
